# Copy this file to `.env` and fill in real values.
# `.env` is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# YouTube Data API v3
# Create a key at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" for the project.
# Required for the YouTube analysis page.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here

# ---------------------------------------------------------------------------
# MongoDB (optional)
# Used to persist analysis results. If Mongo is unreachable the app still
# runs and simply reports that results were not saved.
# Set STORAGE_ENABLED=false to skip persistence entirely.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=feedback_fusion
STORAGE_ENABLED=true

# ---------------------------------------------------------------------------
# Analysis tuning
# ---------------------------------------------------------------------------
# Maximum comments/reviews fetched per analysis run.
MAX_COMMENTS=500
# VADER compound score thresholds for labelling sentiment.
POSITIVE_THRESHOLD=0.05
NEGATIVE_THRESHOLD=-0.05

# ---------------------------------------------------------------------------
# Summarization (optional, requires requirements-ml.txt)
# Falls back to an extractive summariser when transformers is not installed.
# ---------------------------------------------------------------------------
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
SUMMARY_MAX_CHARS=3000

# ---------------------------------------------------------------------------
# Scraping (optional, requires requirements-scraping.txt)
# ---------------------------------------------------------------------------
CHROME_HEADLESS=true
SCRAPE_MAX_PAGES=5

# ---------------------------------------------------------------------------
# Firebase web config for the HTML login/registration pages.
# These values are public by design (they ship in client-side JS) but are
# kept here so firebase-config.js can be generated per environment.
# Copy firebase-config.example.js to firebase-config.js and fill it in.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
